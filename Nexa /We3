        <!-- Slider controls -->
        <div class="slider-arrow prev" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></div>
        <div class="slider-arrow next" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></div>
        <div class="slider-dots" id="dotsContainer"></div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="section" id="about">
        <div class="section-container">
            <div class="section-header">
                <span class="section-tag">Who We Are</span>
                <h2>About Nexa Broadcast</h2>
                <p>We are a team of passionate visual artists and engineers dedicated to pushing the boundaries of media production.</p>
            </div>
            <div class="about-grid">
                <div class="about-img">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2070&auto=format&fit=crop" alt="Nexa team">
                </div>
                <div>
                    <h3 style="font-size:2rem; margin-bottom:15px;">Crafting Visual Stories Since 2018</h3>
                    <p style="color:var(--text-secondary); margin-bottom:20px;">From a small studio to a full‑fledged broadcast house, Nexa Broadcast has delivered thousands of projects across photography, live streaming, and event production. Our obsession with the latest gear and techniques ensures your content stands out.</p>
                    <div class="about-stats">
