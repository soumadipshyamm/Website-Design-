    <!-- HERO SLIDER WITH ANIMATED GRAPHICS & PARTICLES -->
    <section class="hero-slider" id="home">
        <!-- Floating particles background -->
        <div class="particles">
            <div class="particle"></div><div class="particle"></div><div class="particle"></div>
            <div class="particle"></div><div class="particle"></div><div class="particle"></div>
            <div class="particle"></div><div class="particle"></div>
        </div>

        <!-- Slide 1 -->
        <div class="slide active" style="background-image: url('https://images.unsplash.com/photo-1598387993441-a364f854c3e1?q=80&w=2070&auto=format&fit=crop');">
            <div class="slide-overlay">
