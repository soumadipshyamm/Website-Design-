        <!-- Slide 2 -->
        <div class="slide" style="background-image: url('https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?q=80&w=2071&auto=format&fit=crop');">
            <div class="slide-overlay">
                <div class="animated-graphic">
                    <div class="graphic-ring"></div>
                    <i class="fa-solid fa-satellite-dish"></i>
