<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexa Broadcast | Photography • Live Streaming • Event Production</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-primary: #0a0a0f;
            --bg-secondary: #111118;
            --bg-card: #16161f;
            --bg-card-hover: #1c1c28;
            --text-primary: #e8e8f0;
            --text-secondary: #b0b0be;
            --text-muted: #8888a0;
            --accent: #00c6e0;
            --accent-glow: #00e5ff;
            --accent2: #7b4fff;
            --accent2-glow: #9d6fff;
            --border: #252535;
            --border-light: #2a2a3a;
            --gradient-hero: linear-gradient(135deg, #0a0a18 0%, #0d1025 30%, #0a0f20 60%, #060610 100%);
            --gradient-accent: linear-gradient(135deg, #00c6e0 0%, #00a8c5 50%, #0099b8 100%);
            --gradient-accent2: linear-gradient(135deg, #7b4fff 0%, #5c3fd4 100%);
            --gradient-card: linear-gradient(145deg, #1a1a28 0%, #151520 100%);
            --shadow-glow: 0 0 40px rgba(0, 198, 224, 0.15);
            --shadow-glow-strong: 0 0 60px rgba(0, 198, 224, 0.25);
            --radius-sm: 8px;
            --radius: 14px;
            --radius-lg: 20px;
            --radius-xl: 28px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --font-heading: 'Segoe UI', system-ui, -apple-system, sans-serif;
            --font-body: 'Inter', 'Segoe UI', system-ui, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 80px;
        }

        body {
            font-family: var(--font-body);
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.7;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* ============ NAVIGATION ============ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 14px 0;
            transition: var(--transition);
            background: transparent;
        }

        .navbar.scrolled {
            background: rgba(10, 10, 18, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            padding: 10px 0;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        .nav-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            z-index: 1001;
        }

        .nav-logo .logo-icon {
            width: 44px;
            height: 44px;
            background: var(--gradient-accent);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
            box-shadow: 0 0 25px rgba(0, 198, 224, 0.4);
            transition: var(--transition);
        }

        .nav-logo:hover .logo-icon {
            box-shadow: 0 0 40px rgba(0, 198, 224, 0.7);
            transform: scale(1.05);
        }

        .nav-logo .logo-text {
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            color: #fff;
        }

        .nav-logo .logo-text span {
            color: var(--accent-glow);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 8px;
            align-items: center;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-secondary);
            padding: 9px 18px;
            border-radius: 25px;
            font-size: 0.92rem;
            font-weight: 500;
            transition: var(--transition);
            white-space: nowrap;
            letter-spacing: 0.2px;
        }

        .nav-links a:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.04);
        }

        .nav-links a.nav-cta {
            background: var(--gradient-accent);
            color: #000;
            font-weight: 600;
            padding: 10px 22px;
            box-shadow: 0 0 20px rgba(0, 198, 224, 0.3);
        }

        .nav-links a.nav-cta:hover {
            box-shadow: 0 0 35px rgba(0, 198, 224, 0.55);
            transform: translateY(-1px);
            background: var(--gradient-accent);
            color: #000;
        }

        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            z-index: 1001;
            background: none;
            border: none;
            padding: 8px;
        }

        .hamburger span {
            width: 28px;
            height: 2.5px;
            background: #fff;
            border-radius: 3px;
            transition: var(--transition);
        }

        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }
        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }

        /* ============ HERO ============ */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--gradient-hero);
            overflow: hidden;
            padding: 120px 30px 80px;
        }

        .hero-bg-particles {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .hero-bg-particles .particle {
            position: absolute;
            border-radius: 50%;
            background: var(--accent);
            opacity: 0;
            animation: floatUp 8s infinite;
        }

        .hero-bg-particles .particle:nth-child(1) {
            width: 4px;
            height: 4px;
            left: 10%;
            animation-delay: 0s;
            animation-duration: 7s;
        }
        .hero-bg-particles .particle:nth-child(2) {
            width: 2px;
            height: 2px;
            left: 25%;
            animation-delay: 2s;
            animation-duration: 9s;
        }
        .hero-bg-particles .particle:nth-child(3) {
            width: 6px;
            height: 6px;
            left: 40%;
            animation-delay: 4s;
            animation-duration: 6s;
        }
        .hero-bg-particles .particle:nth-child(4) {
            width: 3px;
            height: 3px;
            left: 55%;
            animation-delay: 1s;
            animation-duration: 8s;
        }
        .hero-bg-particles .particle:nth-child(5) {
            width: 5px;
            height: 5px;
            left: 70%;
            animation-delay: 3s;
            animation-duration: 10s;
        }
        .hero-bg-particles .particle:nth-child(6) {
            width: 2px;
            height: 2px;
            left: 85%;
            animation-delay: 5s;
            animation-duration: 7.5s;
        }
        .hero-bg-particles .particle:nth-child(7) {
            width: 7px;
            height: 7px;
            left: 15%;
            animation-delay: 6s;
            animation-duration: 11s;
        }
        .hero-bg-particles .particle:nth-child(8) {
            width: 3px;
            height: 3px;
            left: 60%;
            animation-delay: 2.5s;
            animation-duration: 8.5s;
        }

        @keyframes floatUp {
            0% {
                bottom: -40px;
                opacity: 0;
                transform: translateX(0) scale(0.5);
            }
            20% {
                opacity: 0.8;
            }
            50% {
                opacity: 0.5;
                transform: translateX(30px) scale(1.3);
            }
            80% {
                opacity: 0.2;
            }
            100% {
                bottom: 110%;
                opacity: 0;
                transform: translateX(-20px) scale(0.3);
            }
        }

        .hero-glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
            z-index: 0;
        }

        .hero-glow-orb.orb-1 {
            width: 500px;
            height: 500px;
            background: rgba(0, 198, 224, 0.08);
            top: -150px;
            right: -100px;
            animation: orbPulse 6s ease-in-out infinite;
        }

        .hero-glow-orb.orb-2 {
            width: 400px;
            height: 400px;
            background: rgba(123, 79, 255, 0.07);
            bottom: -100px;
            left: -80px;
            animation: orbPulse 8s ease-in-out infinite reverse;
        }

        @keyframes orbPulse {
            0%,
            100% {
                transform: scale(1);
                opacity: 0.7;
            }
            50% {
                transform: scale(1.25);
                opacity: 1;
            }
        }

        .hero-content {
            position: relative;
            z-index: 1;
            text-align: center;
            max-width: 850px;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(0, 198, 224, 0.1);
            border: 1px solid rgba(0, 198, 224, 0.3);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--accent-glow);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 28px;
            animation: fadeInUp 0.8s ease;
        }

        .hero-content h1 {
            font-family: var(--font-heading);
            font-size: clamp(2.6rem, 5.5vw, 4.2rem);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -1.5px;
            margin-bottom: 20px;
            animation: fadeInUp 0.8s ease 0.1s both;
        }

        .hero-content h1 .highlight {
            background: var(--gradient-accent);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-content p {
            font-size: 1.15rem;
            color: var(--text-secondary);
            max-width: 600px;
            margin: 0 auto 36px;
            animation: fadeInUp 0.8s ease 0.2s both;
            line-height: 1.8;
        }

        .hero-buttons {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeInUp 0.8s ease 0.3s both;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 28px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: var(--transition);
            letter-spacing: 0.3px;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--gradient-accent);
            color: #000;
            box-shadow: 0 0 30px rgba(0, 198, 224, 0.35);
        }
        .btn-primary:hover {
            box-shadow: 0 0 50px rgba(0, 198, 224, 0.6);
            transform: translateY(-2px);
        }
        .btn-outline {
            background: transparent;
            color: #fff;
            border: 2px solid var(--border-light);
        }
        .btn-outline:hover {
            border-color: var(--accent);
            background: rgba(0, 198, 224, 0.06);
            box-shadow: 0 0 25px rgba(0, 198, 224, 0.15);
        }
        .btn-accent2 {
            background: var(--gradient-accent2);
            color: #fff;
            box-shadow: 0 0 25px rgba(123, 79, 255, 0.35);
        }
        .btn-accent2:hover {
            box-shadow: 0 0 45px rgba(123, 79, 255, 0.55);
            transform: translateY(-2px);
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ============ SECTION COMMONS ============ */
        .section {
            padding: 100px 30px;
        }

        .section-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-tag {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent-glow);
            margin-bottom: 12px;
            background: rgba(0, 198, 224, 0.08);
            padding: 6px 16px;
            border-radius: 20px;
        }

        .section-header h2 {
            font-family: var(--font-heading);
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            font-weight: 700;
            letter-spacing: -0.8px;
            margin-bottom: 14px;
            line-height: 1.2;
        }

        .section-header p {
            color: var(--text-secondary);
            max-width: 550px;
            margin: 0 auto;
            font-size: 1rem;
        }

        /* ============ SERVICES ============ */
        #services {
            background: var(--bg-secondary);
            position: relative;
        }

        #services::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border), transparent);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 22px;
        }

        .service-card {
            background: var(--gradient-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 32px 26px;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            cursor: default;
        }

        .service-card::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at center, rgba(0, 198, 224, 0.03) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.5s;
            pointer-events: none;
        }

        .service-card:hover {
            border-color: rgba(0, 198, 224, 0.35);
            transform: translateY(-6px);
            box-shadow: var(--shadow-glow);
            background: var(--bg-card-hover);
        }
        .service-card:hover::after {
            opacity: 1;
        }

        .service-icon {
            width: 56px;
            height: 56px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
            transition: var(--transition);
        }

        .service-icon.cyan {
            background: rgba(0, 198, 224, 0.12);
            color: var(--accent-glow);
        }
        .service-icon.purple {
            background: rgba(123, 79, 255, 0.12);
            color: var(--accent2-glow);
        }
        .service-icon.green {
            background: rgba(0, 224, 160, 0.12);
            color: #00e0a0;
        }
        .service-icon.orange {
            background: rgba(255, 160, 60, 0.12);
            color: #ffa03c;
        }
        .service-icon.pink {
            background: rgba(255, 80, 140, 0.12);
            color: #ff508c;
        }
        .service-icon.yellow {
            background: rgba(255, 210, 50, 0.12);
            color: #ffd232;
        }

        .service-card h3 {
            font-family: var(--font-heading);
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }
        .service-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* ============ PLATFORMS STRIP ============ */
        .platforms-strip {
            background: var(--bg-card);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: 40px 30px;
            text-align: center;
        }

        .platforms-strip .label {
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .platform-icons {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 30px;
            align-items: center;
        }

        .platform-icon {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            font-size: 2.2rem;
            color: var(--text-muted);
            transition: var(--transition);
            text-decoration: none;
            cursor: pointer;
        }
        .platform-icon span {
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        .platform-icon:hover {
            color: #fff;
            transform: translateY(-4px);
        }
        .platform-icon.yt:hover {
            color: #ff0000;
        }
        .platform-icon.fb:hover {
            color: #1877f2;
        }
        .platform-icon.ig:hover {
            color: #e4405f;
        }
        .platform-icon.tw:hover {
            color: #9146ff;
        }
        .platform-icon.li:hover {
            color: #0a66c2;
        }
        .platform-icon.x:hover {
            color: #fff;
        }

        /* ============ EQUIPMENT / DOME SHOWCASE ============ */
        #equipment {
            background: var(--bg-primary);
            position: relative;
        }

        .equipment-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
        }

        .equipment-visual {
            position: relative;
            border-radius: var(--radius-lg);
            overflow: hidden;
            aspect-ratio: 1 / 0.85;
            background: var(--bg-card);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-glow);
        }

        .dome-display {
            text-align: center;
            padding: 40px;
        }

        .dome-display .dome-icon-wrap {
            width: 140px;
            height: 140px;
            margin: 0 auto 20px;
            background: radial-gradient(circle at center, rgba(0, 198, 224, 0.2) 0%, rgba(0, 198, 224, 0.02) 70%);
            border-r
